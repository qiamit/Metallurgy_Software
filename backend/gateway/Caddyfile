{
  auto_https off
  servers {
    # Slow-client / idle limits (analysis + AI calls can take ~90 s upstream).
    timeouts {
      read_header 15s
      idle 2m
    }
  }
}

:80 {
  # Largest legitimate request: a 25 MB storage upload (bucket limit). functions caps JSON at 15 MB itself.
  request_body {
    max_size 30MB
  }

  # CORS allow-list. Only these origins get Access-Control-Allow-Origin:
  #   FRONTEND_ORIGIN / FRONTEND_ORIGIN_ALT  exact production / staging frontend origins
  #   CORS_DEV_ORIGIN_REGEX                  local Vite dev servers; set to ^$ in production to turn off
  @localDev header_regexp Origin {$CORS_DEV_ORIGIN_REGEX:^https?://(localhost|127\.0\.0\.1):(517[3-9]|518[0-5])$}
  header @localDev Access-Control-Allow-Origin "{http.request.header.Origin}"

  # Production frontend origin(s), set on the Railway `api` service
  @prod header Origin {$FRONTEND_ORIGIN:https://unset.invalid}
  header @prod Access-Control-Allow-Origin "{$FRONTEND_ORIGIN:https://unset.invalid}"

  @prodAlt header Origin {$FRONTEND_ORIGIN_ALT:https://unset.invalid}
  header @prodAlt Access-Control-Allow-Origin "{$FRONTEND_ORIGIN_ALT:https://unset.invalid}"

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "DENY"
    Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
    X-Permitted-Cross-Domain-Policies "none"
    Access-Control-Allow-Credentials "true"
    Access-Control-Expose-Headers "Content-Range, Range, Content-Location, Content-Profile, Preference-Applied, X-Request-Id"
    Vary "Origin"
  }

  # Do not advertise Caddy / PostgREST / GoTrue versions (deferred: applies to proxied responses too).
  header -Server

  @preflight method OPTIONS
  handle @preflight {
    header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
    header Access-Control-Allow-Headers "Authorization, apikey, Content-Type, Accept, Accept-Profile, Content-Profile, Prefer, Range, X-Client-Info, X-Supabase-Api-Version, X-Requested-With, Profile, X-User-Jwt, x-upsert, cache-control, content-disposition"
    header Access-Control-Max-Age "86400"
    respond "" 204
  }

  @health path /health
  handle @health {
    respond "ok" 200
  }

  @auth path /auth/v1 /auth/v1/*
  handle @auth {
    uri strip_prefix /auth/v1
    reverse_proxy {$GOTRUE_UPSTREAM} {
      header_down -Access-Control-Allow-Origin
      header_down -Access-Control-Allow-Credentials
      header_down -Access-Control-Allow-Headers
      header_down -Access-Control-Allow-Methods
      header_down -Access-Control-Expose-Headers
      # Upstream may be waking from sleep or redeploying: keep retrying the connection briefly.
      lb_try_duration 30s
      lb_try_interval 500ms
    }
  }

  @rest path /rest/v1 /rest/v1/*
  handle @rest {
    uri strip_prefix /rest/v1
    reverse_proxy {$PGRST_UPSTREAM} {
      header_down -Access-Control-Allow-Origin
      header_down -Access-Control-Allow-Credentials
      header_down -Access-Control-Allow-Headers
      header_down -Access-Control-Allow-Methods
      header_down -Access-Control-Expose-Headers
      # Upstream may be waking from sleep or redeploying: keep retrying the connection briefly.
      lb_try_duration 30s
      lb_try_interval 500ms
    }
  }

  @storage path /storage/v1 /storage/v1/*
  handle @storage {
    uri strip_prefix /storage/v1
    reverse_proxy {$STORAGE_UPSTREAM} {
      header_down -Access-Control-Allow-Origin
      header_down -Access-Control-Allow-Credentials
      header_down -Access-Control-Allow-Headers
      header_down -Access-Control-Allow-Methods
      header_down -Access-Control-Expose-Headers
      # Upstream may be waking from sleep or redeploying: keep retrying the connection briefly.
      lb_try_duration 30s
      lb_try_interval 500ms
    }
  }

  @functions path /functions/v1 /functions/v1/*
  handle @functions {
    uri strip_prefix /functions/v1
    reverse_proxy {$FUNCTIONS_UPSTREAM} {
      header_down -Access-Control-Allow-Origin
      header_down -Access-Control-Allow-Credentials
      header_down -Access-Control-Allow-Headers
      header_down -Access-Control-Allow-Methods
      header_down -Access-Control-Expose-Headers
      # Upstream may be waking from sleep or redeploying: keep retrying the connection briefly.
      lb_try_duration 30s
      lb_try_interval 500ms
    }
  }

  handle {
    respond "Not Found" 404
  }
}
